<Window x:Class="CharacterSketchApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CharacterSketchApp"
        mc:Ignorable="d"
        Title="Character Sketch App" Height="600" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sidebar List -->
        <ListBox x:Name="SketchesListBox" Grid.Row="1" Grid.Column="0" Margin="5" SelectionChanged="SketchesListBox_SelectionChanged"/>

        <!-- Splitter -->
        <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Gray"/>

        <!-- Detail View -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" Margin="10">
            <StackPanel>
                <Label Content="Title"/>
                <TextBox x:Name="TitleTextBox"/>
                <Label Content="Character Name"/>
                <TextBox x:Name="CharacterNameTextBox"/>
                <Label Content="Nickname"/>
                <TextBox x:Name="NicknameTextBox"/>
                <Label Content="Birth Date and Place"/>
                <TextBox x:Name="BirthDatePlaceTextBox"/>
                <Label Content="Character Role"/>
                <TextBox x:Name="CharacterRoleTextBox"/>
                <Label Content="Physical Descriptions"/>
                <TextBox x:Name="PhysicalDescriptionsTextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                <Label Content="Age"/>
                <TextBox x:Name="AgeTextBox"/>
                <Label Content="Race"/>
                <TextBox x:Name="RaceTextBox"/>
                <Label Content="Eye Colour"/>
                <TextBox x:Name="EyeColourTextBox"/>
                <Label Content="Hair Colour and Style"/>
                <TextBox x:Name="HairColourStyleTextBox"/>
                <Label Content="Build/Height/Weight"/>
                <TextBox x:Name="BuildHeightWeightTextBox"/>
                <Label Content="Skin Tone"/>
                <TextBox x:Name="SkinToneTextBox"/>
                <Label Content="Style of Dress"/>
                <TextBox x:Name="StyleOfDressTextBox"/>
                <Label Content="Characteristics and Mannerisms"/>
                <TextBox x:Name="CharacteristicsAndMannerismsTextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                <Label Content="Personality Traits"/>
                <TextBox x:Name="PersonalityTraitsTextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                <Label Content="Background"/>
                <TextBox x:Name="BackgroundTextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                <Label Content="Internal Conflicts"/>
                <TextBox x:Name="InternalConflictsTextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                <Label Content="External Conflicts"/>
                <TextBox x:Name="ExternalConflictsTextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                <Label Content="Occupation and Education"/>
                <TextBox x:Name="OccupationEducationTextBox"/>
                <Label Content="Miscellaneous Notes"/>
                <TextBox x:Name="MiscellaneousNotesTextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="80"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="10">
            <Button Content="Add Sketch" Width="100" Margin="5" Click="AddSketchButton_Click"/>
            <Button Content="Update Sketch" Width="100" Margin="5" Click="UpdateSketchButton_Click"/>
            <Button Content="Delete Sketch" Width="100" Margin="5" Click="DeleteSketchButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
